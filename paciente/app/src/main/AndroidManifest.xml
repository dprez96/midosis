<?xml version="1.0" encoding="utf-8"?>
<!--
  Internet se usa solo para el canje con código corto y PIN (HU-10), cuando el paciente lo
  pide. Las alarmas, la verificación del código y el tratamiento siguen funcionando sin
  conexión (HU-15, HU-09): nada de eso pasa por la red. La configuración de red exige HTTPS.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+: mostrar la notificación de la toma. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 12+: alarmas exactas. Desde Android 14 lo concede el paciente en Ajustes. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Reprogramar las alarmas al encender el teléfono: Android las borra al apagarse. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Pedir con un solo toque que MiDosis quede fuera del ahorro de batería (HU-24). Sin él, el
      paciente debe buscar la aplicación en la lista de todas las del teléfono: en un Motorola
      fueron 24 desplazamientos. Google Play lo admite para recordatorios de medicamentos, cuya
      función principal depende de alarmas puntuales; se justifica al publicar.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />
    <!-- Leer el código del comprobante (HU-11). La imagen se analiza en el teléfono y no se guarda. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".AplicacionMiDosis"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/red"
        android:label="@string/nombre_app"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".ui.PantallaPrincipal"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".alarmas.ReceptorDeAlarma"
            android:exported="false" />

        <!-- No exportado: estos avisos los envía solo el sistema, que puede entregarlos
             igual. Ninguna otra aplicación puede dispararlo. -->
        <receiver
            android:name=".alarmas.ReceptorDeArranque"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
