# Copia este archivo como .env.local y completa los valores de la app web
# «MiDosis Farmacia»: consola de Firebase > Configuración del proyecto > Tus apps.
# .env.local no se versiona.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=midosis-desarrollo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=midosis-desarrollo
VITE_FIREBASE_APP_ID=
